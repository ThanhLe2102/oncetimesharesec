# PostgreSQL connection string (SSL recommended for production).
# Examples:
# - Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# - Vercel Postgres: provided automatically when you connect the integration
# - Local: postgresql://postgres:postgres@localhost:5432/onetimesecretshare
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
